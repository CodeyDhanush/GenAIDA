# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Cloud SQL Database variables (Optional - fallback in-memory store is used if not configured)
SQL_HOST=
SQL_DB_NAME=
SQL_USER=
SQL_PASSWORD=
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=

# Email Dispatch Configuration (for real OTP verification emails to user inboxes)
# Option A: Gmail with App Password (generate at https://myaccount.google.com/apppasswords) [Recommended]
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Option B: Resend API (100 free emails/day - https://resend.com)
RESEND_API_KEY=
RESEND_FROM=

# Option C: Generic SMTP (SendGrid, Mailgun, AWS SES, Postmark, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# SMS Dispatch Configuration (for real phone SMS OTP delivery)
# Option A: Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Option B: Fast2SMS (India)
FAST2SMS_API_KEY=
